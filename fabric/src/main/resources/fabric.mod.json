{
  "schemaVersion": 1,
  "id": "spframework",
  "version": "${version}",

  "name": "SP-Framework",
  "description": "",
  "authors": [],
  "contact": {},

  "license": "Custom",
  "icon": "assets/fabric/icon.png",

  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.teujaem.spFramework.client.SPFrameworkDataGenerator"
    ],
    "client": [
      "net.teujaem.spFramework.client.SPFrameworkClient"
    ],
    "main": [
      "net.teujaem.spFramework.SPFramework"
    ]
  },

  "mixins": [
    "fabric.mixins.json"
    ,{
      "config": "fabric.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
